{
  "name": "thenestchurch-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
